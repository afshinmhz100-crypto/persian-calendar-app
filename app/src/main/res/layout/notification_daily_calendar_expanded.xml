<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <!-- Top Row: Day Box (Right) + Persian Date (Center) + Weather (Left) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Right: Day number inside square box -->
        <LinearLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_notif_day_box"
            android:gravity="center">

            <TextView
                android:id="@+id/notif_day_number_exp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="۲۴"
                android:textColor="#FFFFFF"
                android:textSize="23sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Center: Date Texts -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/notif_persian_date_exp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="سه‌شنبه ۲۴ مرداد ۱۴۰۵"
                android:textColor="#191C1E"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_sub_dates_exp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="15 August 2026 • ۲۹ صفر ۱۴۴۸"
                android:textColor="#5A6065"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Left Side: Weather information -->
        <LinearLayout
            android:id="@+id/notif_weather_container_exp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical|end"
            android:orientation="vertical"
            android:paddingStart="6dp">

            <TextView
                android:id="@+id/notif_weather_temp_exp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌤️ ۲۸°"
                android:textColor="#006874"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_weather_desc_exp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تهران • صاف"
                android:textColor="#5A6065"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Row: Occasion / Holiday summary -->
    <TextView
        android:id="@+id/notif_occasion_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="#15006874"
        android:gravity="start|center_vertical"
        android:paddingStart="8dp"
        android:paddingTop="5dp"
        android:paddingEnd="8dp"
        android:paddingBottom="5dp"
        android:text="📌 مناسبت امروز: روز مقاومت اسلامی"
        android:textColor="#004D56"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:visibility="visible" />
</LinearLayout>
